<%=
  render(
    Primer::Alpha::Dialog.new(
      id: "finance-entry-dialog",
      title:,
      size: :large
    )
  ) do |dialog|
    dialog.with_body do
      primer_form_with(
        model: entry,
        url: form_url,
        method: form_method,
        data: { turbo: true },
        id: "finance-entry-form"
      ) do |f|
        render(FinanceEntries::EntryForm.new(f))
      end
    end

    dialog.with_footer do
      concat render(Primer::Beta::Button.new(data: { "close-dialog-id": "finance-entry-dialog" })) {
        t(:button_cancel)
      }
      concat render(
        Primer::Beta::Button.new(
          scheme: :primary,
          type: :submit,
          form: "finance-entry-form"
        )
      ) { entry.persisted? ? t(:button_save) : t(:button_create) }
    end
  end
%>
