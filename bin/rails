#!/usr/bin/env ruby
# frozen_string_literal: true

ENGINE_ROOT = File.expand_path("..", __dir__)
ENGINE_PATH = File.expand_path("../lib/open_project/finances/engine", __dir__)

ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup" if File.exist?(ENV["BUNDLE_GEMFILE"])

if ENV["OPENPROJECT_ROOT"]
  path = Pathname(ENV["OPENPROJECT_ROOT"]).join("lib")
  $LOAD_PATH.unshift(path.to_s)
else
  warn "Error: please define OPENPROJECT_ROOT pointing to your OpenProject core root directory"
  exit 1
end

require "rails/all"
require "rails/engine/commands"
